# Smart Digest — Environment Variables для Backend
# Скопируйте в .env и заполните значения

# AI Provider: openai, anthropic, mock
AI_PROVIDER=mock

# API ключи (если используете реальный AI)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Server settings
HOST=0.0.0.0
PORT=8000

# Python
PYTHONUNBUFFERED=1
